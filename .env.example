# LLM runtime
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
HF_ENDPOINT=https://hf-mirror.com
TORCH_WHL_INDEX_URL=https://download.pytorch.org/whl/cu126
OPENAI_WHISPER_REQUIREMENT=openai-whisper==20250625

# Embeddings and scenic knowledge base
MODEL_EMBEDDING_NAME=bge-large-zh-v1.5
MODEL_EMBEDDING_PATH=./models/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
CHROMA_DB_DIR=./data/chroma_db
KNOWLEDGE_BASE_DIR=./data/knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Avatar runtime
MODEL_AVATAR_NAME=SoulX-FlashHead-Lite-1.3B
MODEL_AVATAR_PATH=./models/SoulX-FlashHead-Lite-1.3B
AVATAR_DEVICE=cuda
AVATAR_TORCH_DTYPE=bfloat16
AVATAR_WARMUP_SECONDS=0.5
AVATAR_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:128
AVATAR_VIDEO_CRF=20
AVATAR_EMPTY_CACHE_BEFORE_INFER=true
AVATAR_EMPTY_CACHE_AFTER_INFER=true

# 3D Memory runtime
MEMORY3D_ENABLED=true
MEMORY3D_WORKSPACE_DIR=data/3d_memory
MEMORY3D_MODEL_DIR=models/apple-sharp
MEMORY3D_SHARP_SOURCE_DIR=models/apple-ml-sharp
MEMORY3D_DEVICE=auto
MEMORY3D_SHARP_COMMAND=sharp
MEMORY3D_MAX_IMAGE_MB=20
MEMORY3D_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# ASR and TTS
MODEL_ASR_NAME=Whisper
MODEL_ASR_PATH=base
WHISPER_DOWNLOAD_DIR=./models/whisper-cache
MODEL_TTS_NAME=Edge-TTS

# Server
HOST=0.0.0.0
PORT=8000

# Notes:
# 1. edge-tts requires network access at runtime.
# 2. The current frontend still loads CDN assets in the browser.
# 3. Collaborators should run bootstrap_windows.bat first.
